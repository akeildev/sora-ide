rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection - users can read/write their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Projects collection
    match /projects/{projectId} {
      // Allow any authenticated user to read projects (needed for room code lookups)
      allow read: if request.auth != null;

      // Allow create if user is authenticated
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;

      // Allow update by any authenticated user (needed for joining via room code)
      // Users can add themselves as collaborators
      allow update: if request.auth != null;

      // Allow delete if user is owner
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // Chats collection - NEW!
    match /chats/{chatId} {
      // Allow read if user owns this chat
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;

      // Allow create if user is authenticated and setting themselves as owner
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;

      // Allow update if user owns this chat
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;

      // Allow delete if user owns this chat
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
